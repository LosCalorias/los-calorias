POSTGRES_USER=loscalorias
POSTGRES_PASSWORD=loscalorias
POSTGRES_DB=loscalorias

# Used when running the backend on the host; docker compose overrides the host to "db".
DATABASE_URL=postgresql+psycopg://loscalorias:loscalorias@localhost:5432/loscalorias

OPENAI_API_KEY=

# Any long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=
