{
  "expo": {
    "name": "LosCalorías",
    "slug": "los-calorias",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "loscalorias",
    "userInterfaceStyle": "automatic",
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
