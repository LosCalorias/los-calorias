{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "release-type": "simple",
      "initial-version": "0.1.0",
      "package-name": "los-calorias",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "toml", "path": "backend/pyproject.toml", "jsonpath": "$.project.version" },
        { "type": "json", "path": "frontend/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/mobile/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/mobile/app.json", "jsonpath": "$.expo.version" }
      ]
    }
  }
}
